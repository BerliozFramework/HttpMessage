{
  "name": "berlioz/http-message",
  "description": "Berlioz HTTP Message is a PHP library whose implements PSR-7 (HTTP message interfaces) and PSR-17 (HTTP Factories) standards.",
  "license": "MIT",
  "homepage": "https://getberlioz.com",
  "support": {
    "issues": "https://github.com/BerliozFramework/Berlioz/issues",
    "source": "https://github.com/BerliozFramework/Berlioz"
  },
  "authors": [
    {
      "name": "Ronan Giron",
      "email": "ronan@getberlioz.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Berlioz\\Http\\Message\\": ""
    }
  },
  "require": {
    "php": "^8.2",
    "ext-fileinfo": "*",
    "berlioz/helpers": "^1.5",
    "psr/http-message": "^1.0 || ^2.0",
    "psr/http-factory": "^1.0 || ^2.0"
  },
  "suggest": {
    "ext-zlib": "To use GzStream"
  },
  "provide": {
    "psr/http-message-implementation": "*",
    "psr/http-factory-implementation": "*"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "3.x-dev"
    }
  },
  "config": {
    "sort-packages": true
  }
}
